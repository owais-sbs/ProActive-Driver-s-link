# Supabase (required for local + Netlify)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer SUPABASE_ANON_KEY on Netlify (server-only). Do NOT set NEXT_PUBLIC_SUPABASE_ANON_KEY
# on Netlify — Next.js embeds all NEXT_PUBLIC_* into the client bundle.
SUPABASE_ANON_KEY=your-anon-key

# Server-only. On Netlify: set scope to Functions / Runtime only (NOT Builds),
# so `next build` cannot embed the value into .next (Secrets Scanning).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional admin credentials — use fake placeholders here, never real passwords.
# On Netlify: Functions/Runtime scope only (same reason as service role key).
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# Notes:
# - Never commit .env / .env.local
# - Netlify does not use .env.local
# - API routes read SUPABASE_SERVICE_ROLE_KEY only at request runtime via lib/secrets.ts

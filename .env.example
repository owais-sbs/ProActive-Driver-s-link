# Supabase (required for local + Netlify)
# On Netlify: Site settings → Environment variables → set for Production AND Builds
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Prefer SUPABASE_ANON_KEY on Netlify (server-only).
# Avoid setting NEXT_PUBLIC_SUPABASE_ANON_KEY on Netlify — Next.js embeds all
# NEXT_PUBLIC_* values into the client bundle, which fails Secrets Scanning.
# Locally you may still use NEXT_PUBLIC_SUPABASE_ANON_KEY if needed.
SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (optional) — use placeholders that are NOT your real credentials
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-admin-password

# Notes:
# - .env / .env.local are for local Next.js only. Never commit them.
# - Netlify does NOT use .env.local — set vars in the Netlify UI.
# - SUPABASE_SERVICE_ROLE_KEY is read at runtime by /api/* routes.

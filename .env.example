# Supabase (required for local + Netlify)
# On Netlify: Site settings → Environment variables → set for Production AND Builds
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (optional)
ADMIN_EMAIL=admin@turboteach.ca
ADMIN_PASSWORD=change-me

# Notes:
# - .env.local is for local Next.js only. Netlify does NOT use .env.local.
# - NEXT_PUBLIC_* are inlined at build time — trigger a new deploy after changing them.
# - SUPABASE_SERVICE_ROLE_KEY is read at runtime by /api/* routes.
